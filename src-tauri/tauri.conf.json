{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stashly",
  "version": "1.2.1",
  "identifier": "io.mekabu.stashly",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stashly",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://booth.pximg.net https://*.booth.pximg.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
